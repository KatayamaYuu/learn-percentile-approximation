{
  "name": "learn-percentile-approximation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.site.json && tsc --noEmit -p tsconfig.worker.json",
    "size:check": "node scripts/check-bundle-size.mjs",
    "bundle:check": "node scripts/check-main-modules.mjs",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages",
    "licenses:check": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow 'MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;MPL-2.0;CC0-1.0' --excludePackages 'spdx-exceptions@2.5.0;spdx-ranges@2.1.1'",
    "verify": "npm run typecheck && npm test && npm run build && npm run size:check && npm run bundle:check && npm run licenses:check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "license-checker-rseidelsohn": "4.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "dependencies": {
    "chart.js": "4.5.1"
  }
}
