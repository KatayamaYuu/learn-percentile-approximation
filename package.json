{
  "name": "learn-percentile-approximation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages",
    "licenses:check": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow 'MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;MPL-2.0;CC0-1.0' --excludePackages 'spdx-exceptions@2.5.0;spdx-ranges@2.1.1'",
    "verify": "npm run typecheck && npm test && npm run licenses:check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "license-checker-rseidelsohn": "4.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
